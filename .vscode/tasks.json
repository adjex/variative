{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Dependencies",
			"type": "composer",
			"command": "install"
		},
		{
			"label": "Update Dependencies",
			"type": "composer",
			"command": "update"
		},
		{
			"label": "Check Syntax",
			"group": "test",
			"type": "composer",
			"command": "run-script",
			"args": [
				"check"
			]
		},
		{
			"label": "Clean Syntax",
			"type": "composer",
			"command": "run-script",
			"args": [
				"clean"
			]
		},
		{
			"label": "Verify Compatibility",
			"group": "test",
			"type": "composer",
			"command": "run-script",
			"args": [
				"compat"
			]
		},
		{
			"label": "Static Analysis",
			"group": "test",
			"type": "composer",
			"command": "run-script",
			"args": [
				"analyze"
			]
		},
		{
			"label": "Unit Tests",
			"group": "test",
			"type": "composer",
			"command": "run-script",
			"args": [
				"test"
			]
		}
	]
}