<?xml version="1.0"?>
<ruleset name="Variative">
	<description>Variative Coding Standard</description>

	<arg name="tab-width" value="4" />

	<!-- PSR12 Standards -->
	<rule ref="PSR12">
		<exclude name="Generic.WhiteSpace.DisallowTabIndent" />
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine" />
		<exclude name="PSR2.Classes.ClassDeclaration.OpenBraceNewLine" />
		<exclude name="PSR12.Classes.OpeningBraceSpace" />
	</rule>

	<!-- Expand line length limit to 160 and ignore limit on comments -->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="160" />
			<property name="ignoreComments" value="true" />
		</properties>
	</rule>

	<!-- Code MUST use an indent of 1 tab, and MUST NOT use spaces for indenting. -->
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent" />
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4" />
			<property name="tabIndent" value="true" />
		</properties>
	</rule>

	<!-- The opening brace for the class MUST go on the same line -->
	<rule ref="Generic.Classes.OpeningBraceSameLine" />

	<!-- The opening brace for the function MUST go on the same line -->
	<rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie" />

	<!-- All constructors MUST use __construct() rather than ClassName() -->
	<rule ref="Generic.NamingConventions.ConstructorName" />

	<!-- Check for duplicated class names -->
	<rule ref="Generic.Classes.DuplicateClassName" />

	<!-- All PHP files MUST declare strict_types=1 -->
	<rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
		<properties>
			<property name="spacesCountAroundEqualsSign" value="0" />
		</properties>
	</rule>

	<!-- All files MUST have a docblock -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen" />
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag" />
	</rule>

	<!-- All classes MUST be have a docblock -->
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude name="Squiz.Commenting.ClassComment.TagNotAllowed" />
	</rule>

	<!-- All functions declared public or protected MUST be have a docblock -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint" />
		<exclude name="Squiz.Commenting.FunctionComment.InvalidNoReturn" />
		<properties>
			<property name="minimumVisibility" value="protected" />
			<property name="skipIfInheritdoc" value="true" />
		</properties>
	</rule>

	<file>src/</file>
	<file>test/</file>
</ruleset>
